# MongoDB Configuration
# For local MongoDB: mongodb://127.0.0.1:27017/sd-shopping
# For MongoDB Atlas: mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/sd-shopping?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/sd-shopping

# JWT Secret (generate a strong random string)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Gmail App Password (for OTP emails)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_app_password_here

# Server Port
PORT=5000
